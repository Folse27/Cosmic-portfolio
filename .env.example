# Copy to .env and fill in. Never commit the real file.

# Postgres connection string (use the pooled one on serverless, e.g. Neon "pooled", Supabase "Session pooler")
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs admin session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Admin login, read by `npm run db:seed` (the password is stored only as a hash)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Optional: enables image uploads (created automatically when you add a Vercel Blob store)
BLOB_READ_WRITE_TOKEN=

# Impressum / privacy policy details (required in production; kept out of the repository).
# Separate address lines with "|".
LEGAL_NAME=Your Name
LEGAL_ADDRESS=Street 1|12345 City|Germany
LEGAL_EMAIL=you@example.com
# Optional
LEGAL_PHONE=
LEGAL_VAT_ID=

# Optional: public base URL for canonical and Open Graph links (e.g. once you have a custom domain)
NEXT_PUBLIC_SITE_URL=
