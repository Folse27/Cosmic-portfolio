{
  "name": "cosmic-portfolio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Personal portfolio with built-in CMS and first-party analytics. Black & deep-red cosmic theme.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-env.ts && tsx scripts/ensure-schema.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:ensure": "tsx scripts/ensure-schema.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "jose": "^5.9.6",
    "next": "^15.4.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
